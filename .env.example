# ==============================================================================
# INGREDIA ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Supabase Authentication & PostgreSQL Database
# Retrieve these from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Google Gemini API Key for natural-language explanations
# (Leave empty to use built-in template-based explanation engine)
VITE_GEMINI_API_KEY=

# Application Mode
VITE_APP_ENV=development
