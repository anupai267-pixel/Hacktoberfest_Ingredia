# ------------------------------------------------------------------------------
# Groq Open-Weight AI Configuration (Supabase Edge Function Server Secrets)
# ------------------------------------------------------------------------------
# IMPORTANT SECURITY NOTE:
# Do NOT put your GROQ_API_KEY into frontend VITE_ environment variables!
# The Groq API key is stored securely on the Supabase Edge Function server.
#
# To set your Groq key on Supabase, run:
#   supabase secrets set GROQ_API_KEY=gsk_your_actual_groq_key_here
#
# (Optional) Preferred open-weight model (default: openai/gpt-oss-20b):
#   supabase secrets set GROQ_MODEL=openai/gpt-oss-20b
# If unavailable or rate-limited, it automatically falls back to llama-3.3-70b-versatile.

# ------------------------------------------------------------------------------
# Legacy / Fallback Settings
# ------------------------------------------------------------------------------
# Built-in deterministic template explanation engine is always active by default
# if Supabase Edge Function or AI keys are unconfigured.
VITE_GEMINI_API_KEY=
