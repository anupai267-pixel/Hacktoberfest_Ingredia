# ==============================================================================
# INGREDIA FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Authentication & PostgreSQL Database (Frontend Client - Optional)
# ------------------------------------------------------------------------------
# Retrieve these from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ------------------------------------------------------------------------------
# Backend API URL (Optional - defaults to http://localhost:3001 or Vite proxy in dev)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:3001

# Application Mode
VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# Groq AI Configuration (Server Secrets - Never commit to frontend!)
# ------------------------------------------------------------------------------
# Set GROQ_API_KEY in server/.env for the Node.js Express backend
# Or set via `supabase secrets set GROQ_API_KEY=...` for Supabase Edge Functions.
