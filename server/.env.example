# ==============================================================================
# INGREDIA BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and insert your actual Groq API key:
# cp .env.example .env
#
# IMPORTANT:
# - Never commit the real .env file with secrets to Git.
# - The server will automatically use the template fallback if no key is provided.

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
PORT=3001
